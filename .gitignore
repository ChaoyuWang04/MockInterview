# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
projects/
# 两个解读库的 PDF 原件默认不追踪;需要时可 git add -f 单篇加入。
# 字幕与转录文本(.srt/.vtt/.md)不在此列,一律追踪——视频会下架,那份文本可能是唯一存世记录。
/papers/**/*.pdf
/readings/_src/**/*.pdf
# 周会的录音转录与截图只留本机;仓库是公开的,只有提炼后的纪要入库
/meetings/*/_src/

# 分流扫描报告是临时产物,不入库
/_扫描报告-*.md
.leet/
/.next-prod/
/.next-check/
/.next-blue/
/.next-green/
interview/cache/

# 模拟面试:语音环境与音频缓存(体积大,可重建)
.venv-voice/   # 语音服务的 Python 环境(441M),用 uv 重建
__pycache__/
*.pyc
/.mlx-models/   # 模型默认放 ~/.mlx-models,这条只防误放进仓库

# 平台题原始截图及本地识别缓存；文字来源归档在 docs/references/平台题
/inbox/

# Playwright MCP 本地抓取缓存（截图/快照/日志），不入库
.playwright-mcp/

# superpowers 技能产出的 spec/plan 不再入库。
# 注意：初期那批已跟踪的历史存档不受本条影响（gitignore 不作用于已跟踪文件），
# 它们仍被 docs/00-START.md 与 docs/09-日常维护.md 当设计档指着，别删。
docs/superpowers/

# 抓图与调试的临时产物,不入库
tmp/

# 其他 agent 工具(WorkBuddy)的本地工作记忆,不入库
.workbuddy-ai/
