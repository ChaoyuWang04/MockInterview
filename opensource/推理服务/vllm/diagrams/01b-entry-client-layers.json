{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "三种入口各经过哪个 client 到达 EngineCore,哪一层开始跨进程",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "用户面对的入口对象"
        },
        "backend": {
          "label": "引擎侧组件"
        },
        "messagebus": {
          "label": "跨进程 client(ZMQ)"
        },
        "cloud": {
          "label": "GPU Worker 进程"
        }
      }
    }
  },
  "layout": {
    "mode": "grid",
    "cols": 3,
    "cellW": 220,
    "cellH": 78,
    "gapX": 70,
    "gapY": 56
  },
  "components": [
    {
      "id": "llm_obj",
      "row": 0,
      "col": 0,
      "type": "frontend",
      "label": "LLM",
      "sublabel": "离线批量入口",
      "tag": "用户代码 · generate() / chat()"
    },
    {
      "id": "asyncllm",
      "row": 0,
      "col": 2,
      "type": "frontend",
      "label": "AsyncLLM",
      "sublabel": "在线服务异步入口",
      "tag": "用户代码 · generate()"
    },
    {
      "id": "llmengine",
      "row": 1,
      "col": 0,
      "type": "backend",
      "label": "LLMEngine",
      "sublabel": "同步引擎"
    },
    {
      "id": "client_abs",
      "row": 2,
      "col": 1,
      "type": "backend",
      "label": "EngineCoreClient",
      "sublabel": "抽象基类 · 工厂在这里选实现"
    },
    {
      "id": "inproc",
      "row": 3,
      "col": 0,
      "type": "backend",
      "label": "InprocClient",
      "sublabel": "同进程直接调用"
    },
    {
      "id": "syncmp",
      "row": 3,
      "col": 1,
      "type": "messagebus",
      "label": "SyncMPClient",
      "sublabel": "子进程 · ZMQ"
    },
    {
      "id": "asyncmp",
      "row": 3,
      "col": 2,
      "type": "messagebus",
      "label": "AsyncMPClient",
      "sublabel": "子进程 · ZMQ + asyncio"
    },
    {
      "id": "core",
      "row": 4,
      "col": 1,
      "type": "backend",
      "label": "EngineCore",
      "sublabel": "调度 + 执行"
    },
    {
      "id": "executor",
      "row": 5,
      "col": 1,
      "type": "backend",
      "label": "ModelExecutor",
      "sublabel": "下发一个 step"
    },
    {
      "id": "workers",
      "row": 5,
      "col": 2,
      "type": "cloud",
      "label": "GPU Worker",
      "sublabel": "PP × TP × PCP 个进程"
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "EngineCore 进程",
      "wraps": [
        "core",
        "executor"
      ]
    },
    {
      "kind": "region",
      "label": "Worker 进程",
      "wraps": [
        "workers"
      ]
    }
  ],
  "connections": [
    {
      "id": "llm-holds-engine",
      "from": "llm_obj",
      "to": "llmengine",
      "label": "持有并驱动",
      "labelDy": 40
    },
    {
      "id": "engine-make-client",
      "from": "llmengine",
      "to": "client_abs",
      "label": "make_client()"
    },
    {
      "id": "async-make-client",
      "from": "asyncllm",
      "to": "client_abs",
      "label": "make_async_mp_client()"
    },
    {
      "id": "pick-inproc",
      "from": "client_abs",
      "to": "inproc",
      "label": "关掉多进程(调试)",
      "variant": "dashed"
    },
    {
      "id": "pick-syncmp",
      "from": "client_abs",
      "to": "syncmp",
      "label": "LLM 默认路线",
      "variant": "emphasis",
      "labelDy": 40
    },
    {
      "id": "pick-asyncmp",
      "from": "client_abs",
      "to": "asyncmp",
      "label": "AsyncLLM 唯一路线",
      "variant": "emphasis"
    },
    {
      "id": "inproc-call",
      "from": "inproc",
      "to": "core",
      "label": "同进程函数调用"
    },
    {
      "id": "syncmp-zmq",
      "from": "syncmp",
      "to": "core",
      "label": "ZMQ 跨进程",
      "variant": "emphasis",
      "labelDy": 40
    },
    {
      "id": "asyncmp-zmq",
      "from": "asyncmp",
      "to": "core",
      "label": "ZMQ 跨进程",
      "variant": "emphasis"
    },
    {
      "id": "core-executor",
      "from": "core",
      "to": "executor"
    },
    {
      "id": "executor-workers",
      "from": "executor",
      "to": "workers",
      "label": "共享内存消息队列",
      "labelDy": 40
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "关键设计",
      "items": [
        "用户代码从不直接接触 EngineCore,只面对 EngineCoreClient 这层抽象",
        "所以同进程与多进程两种模式能无缝切换:调试用 InprocClient,生产用 AsyncMPClient"
      ]
    },
    {
      "dot": "amber",
      "title": "哪一层开始跨进程",
      "items": [
        "分叉就在 client 这一层:InprocClient 往下还是同一个进程",
        "两个 MP client 往下是第一次跨进程,走 ZMQ 到 EngineCore 子进程",
        "ModelExecutor 到 Worker 是第二次跨进程,走共享内存消息队列",
        "单卡默认 uniproc,Worker 直接住在 EngineCore 进程里"
      ]
    },
    {
      "dot": "slate",
      "title": "三条路线怎么选中",
      "items": [
        "LLM 默认开多进程,落到 SyncMPClient",
        "把多进程开关关掉才落到 InprocClient,这是单进程调试用法",
        "AsyncLLM 直接走异步工厂,落到 AsyncMPClient",
        "「只要 asyncio 不要多进程」这种组合会直接抛错,没有第四条路"
      ]
    }
  ]
}
