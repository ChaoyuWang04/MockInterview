{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "一条请求的四个阶段:每一跳落在哪个进程、哪个线程",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      820,
      780
    ]
  },
  "participants": [
    {
      "id": "client",
      "type": "external",
      "label": "客户端",
      "sublabel": "HTTP / SSE"
    },
    {
      "id": "api",
      "type": "frontend",
      "label": "API 进程",
      "sublabel": "FastAPI + asyncio"
    },
    {
      "id": "core_io",
      "type": "messagebus",
      "label": "IO 线程",
      "sublabel": "EngineCore 进程"
    },
    {
      "id": "core_main",
      "type": "backend",
      "label": "主线程",
      "sublabel": "EngineCore · busy loop"
    },
    {
      "id": "worker",
      "type": "cloud",
      "label": "GPU Worker",
      "sublabel": "每卡一个进程"
    }
  ],
  "segments": [
    {
      "from": 193,
      "to": 322,
      "label": "阶段 A:请求接入 · 整条请求只发生一次"
    },
    {
      "from": 322,
      "to": 454,
      "label": "阶段 B:Prefill · 一次;prompt 长则切块,切几块几次"
    },
    {
      "from": 454,
      "to": 586,
      "label": "阶段 C:Decode 循环 · 每吐一个 token 走一遍"
    },
    {
      "from": 586,
      "to": 694,
      "label": "阶段 D:流式返回 · B、C 每产出一个 token 就走一遍"
    }
  ],
  "activations": [
    {
      "participant": "api",
      "from": 203,
      "to": 278,
      "type": "frontend"
    },
    {
      "participant": "core_main",
      "from": 330,
      "to": 436,
      "type": "backend"
    },
    {
      "participant": "worker",
      "from": 334,
      "to": 388,
      "type": "cloud"
    },
    {
      "participant": "core_main",
      "from": 458,
      "to": 564,
      "type": "backend"
    },
    {
      "participant": "worker",
      "from": 460,
      "to": 516,
      "type": "cloud"
    },
    {
      "participant": "api",
      "from": 628,
      "to": 688,
      "type": "frontend"
    }
  ],
  "messages": [
    {
      "id": "m01",
      "from": "client",
      "to": "api",
      "y": 210,
      "label": "① POST /v1/chat/completions",
      "variant": "emphasis"
    },
    {
      "id": "m02",
      "from": "api",
      "to": "core_io",
      "y": 251,
      "label": "②③④ 套模板 → tokenize → ZMQ 发出",
      "variant": "emphasis",
      "note": "chat template 由 renderer 套好,InputProcessor 只做 tokenize 与构造请求"
    },
    {
      "id": "m03",
      "from": "core_io",
      "to": "core_main",
      "y": 292,
      "label": "⑤⑥ 入队 → 建 Request → 进 waiting",
      "note": "block hash 在这里算,不在 API 进程"
    },
    {
      "id": "m04",
      "from": "core_main",
      "to": "worker",
      "y": 342,
      "label": "⑦⑧ 分配 KV block → 下发前向",
      "variant": "emphasis",
      "note": "命中 prefix cache 就省掉那段 prefill"
    },
    {
      "id": "m05",
      "from": "worker",
      "to": "core_main",
      "y": 383,
      "label": "前向整段 prompt,采样第 1 个 token",
      "variant": "return",
      "note": "注意力顺手写下这些 token 的 KV;采样在 Worker 跑"
    },
    {
      "id": "m06",
      "from": "core_main",
      "to": "core_io",
      "y": 424,
      "label": "⑨⑬ WAITING → RUNNING,推 output_queue"
    },
    {
      "id": "m07",
      "from": "core_main",
      "to": "worker",
      "y": 474,
      "label": "⑩⑪ 这步只要 1 个 token → 前向",
      "variant": "emphasis",
      "note": "注意力按 block table 读回全部历史 KV"
    },
    {
      "id": "m08",
      "from": "worker",
      "to": "core_main",
      "y": 515,
      "label": "采样第 t 个 token",
      "variant": "return"
    },
    {
      "id": "m09",
      "from": "core_main",
      "to": "core_io",
      "y": 556,
      "label": "⑫⑬ 判 EOS 与长度上限,推 output_queue",
      "note": "没结束回到 ⑩;结束则释放 KV block"
    },
    {
      "id": "m10",
      "from": "core_io",
      "to": "api",
      "y": 606,
      "label": "⑬ msgpack → ZMQ(PUSH → PULL)",
      "variant": "emphasis"
    },
    {
      "id": "m11",
      "from": "api",
      "to": "client",
      "y": 647,
      "label": "⑭⑮⑯ detokenize → 判 stop → SSE chunk",
      "note": "stop string 要先把 token 变回文字才判得出来"
    },
    {
      "id": "m12",
      "from": "api",
      "to": "client",
      "y": 688,
      "label": "⑰ 结束才发 data: [DONE]",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "四个阶段各发生几次",
      "items": [
        "A 请求接入:整条请求只发生一次",
        "B Prefill:一次;prompt 长到要切块时,切几块就几次",
        "C Decode:每吐一个 token 走一遍,是整条请求里唯一的循环",
        "D 流式返回:不是排在最后,B 和 C 每产出一个 token 就顺带走一遍"
      ]
    },
    {
      "dot": "amber",
      "title": "两个容易记反的归属",
      "items": [
        "block hash 在 EngineCore 进程建 Request 时算,不在 API 进程",
        "采样在 GPU Worker 里跑,EngineCore 主线程只是发起那次调用"
      ]
    },
    {
      "dot": "slate",
      "title": "停止条件分在两个进程",
      "items": [
        "EOS 和长度上限在 EngineCore 判,判完就不再调度这条请求",
        "stop string 要先把 token 变回文字,所以只能在 API 进程判",
        "也因此 API 侧判出的结束要反向通知 EngineCore 撤销请求"
      ]
    }
  ]
}
