  "cards": [
    {
      "dot": "cyan",
      "title": "每个张量的构造点都一样",
      "items": [
        "torch.tensor(列表, dtype, pin_memory=True).cuda(non_blocking=True)",
        "ids、positions 用 int64;cu_seqlens、slot_mapping、context_lens、block_tables 用 int32",
        "temperatures 用 float32,只有 rank 0 建"
      ]
    },
    {
      "dot": "amber",
      "title": "槽位怎么算",
      "items": [
        "prefill:从 cached 所在桌到 end 所在桌逐桌铺区间,首桌加偏移、末桌截到 end",
        "decode:只有一格,末桌号×256 + 末桌已有 token 数 − 1",
        "warmup 的假客人没有桌位表,直接 continue,slot_mapping 为空"
      ]
    },
    {
      "dot": "rose",
      "title": "桌位表什么时候才带",
      "items": [
        "prefill:批里有任何一人 cached>0 时才建,否则工单里是 None",
        "decode:每轮必建;短的桌位表用 -1 补到最长那位的宽度",
        "示例丙:A [10,11,-1,-1]、B [2,3,12,-1]、C [13,14,15,16]"
      ]
    }
  ]
