    "views": [
      { "id": "first-token", "label": "收单到第一个 token", "focus": ["user", "engine", "scheduler", "blocks", "runner"], "note": "step 1:A 入座、300 个 token 一次算完,postprocess 把 tA1 写回客人对象。" },
      { "id": "cross-process", "label": "跨进程的那一跳", "focus": ["runner", "shm", "runnerN"], "note": "TP=2 时 rank 0 只单向广播方法名与瘦身参数;分店同名执行,不回传。" },
      { "id": "chunked-and-finish", "label": "分块预填充与结账", "focus": ["engine", "scheduler", "blocks", "runner"], "note": "B 分 512+88 两轮;第一轮采出的 token 被丢弃;step 5 两人结账退桌。" }
