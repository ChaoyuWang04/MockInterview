  "cards": [
    {
      "dot": "emerald",
      "title": "第一个 token 在哪产生",
      "items": [
        "prefill 那一轮厨房就采样,返回 list[int],一人一个",
        "写回发生在主进程领班的 postprocess:append_token",
        "分块预填充没做完的那一轮,采出的 token 被 continue 丢弃"
      ]
    },
    {
      "dot": "violet",
      "title": "唯一跨进程的一跳",
      "items": [
        "rank 0 把 [方法名, *参数] pickle 进 1 MiB 共享内存,Event 叫醒分店,不等回复",
        "Sequence 瘦身:4 个计数 + block_table + token_ids(prefill)或 last_token(decode)",
        "分店 logits 被 gather 到 rank 0 后置 None,没有东西可回传"
      ]
    },
    {
      "dot": "amber",
      "title": "同步与异步",
      "items": [
        "generate → step → schedule / call / postprocess 全是同进程同步调用",
        "H2D 拷贝 pinned + non_blocking 不等;.tolist() 是等 GPU 的那一点",
        "主进程与分店只在 all_reduce / gather 里会合,没有 ack"
      ]
    }
  ]
}
